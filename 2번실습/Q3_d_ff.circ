  <vhdl appearance="logisim_evolution" name="d_ff">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity d_ff is&#13;
    port (&#13;
        d, clk : in std_logic;&#13;
        q, q_bar : out std_logic&#13;
    );&#13;
end d_ff;&#13;
&#13;
architecture rtl of d_ff is&#13;
    signal qi : std_logic;&#13;
begin&#13;
    process(clk)&#13;
    begin&#13;
        if rising_edge(clk) then&#13;
            qi &lt;= d;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q &lt;= qi;&#13;
    q_bar &lt;= not qi;&#13;
end rtl;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="d_latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity d_latch is&#13;
    port (&#13;
        d, en : in std_logic;&#13;
        q, q_bar : out std_logic&#13;
    );&#13;
end d_latch;&#13;
&#13;
architecture rtl of d_latch is&#13;
    signal qi : std_logic;&#13;
begin&#13;
    process(d, en)&#13;
    begin&#13;
        if en = '1' then&#13;
            qi &lt;= d;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q &lt;= qi;&#13;
    q_bar &lt;= not qi;&#13;
end rtl;&#13;
</vhdl>
