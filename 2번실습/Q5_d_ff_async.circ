  <vhdl appearance="logisim_evolution" name="d_ff_async">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity d_ff_async is&#13;
    port (&#13;
        d, clk, set, clr : in std_logic;&#13;
        q, q_bar : out std_logic&#13;
    );&#13;
end d_ff_async;&#13;
&#13;
architecture rtl of d_ff_async is&#13;
    signal qi : std_logic;&#13;
begin&#13;
    process(clk, set, clr)&#13;
    begin&#13;
        if clr = '1' then&#13;
            qi &lt;= '0';&#13;
        elsif set = '1' then&#13;
            qi &lt;= '1';&#13;
        elsif rising_edge(clk) then&#13;
            qi &lt;= d;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q &lt;= qi;&#13;
    q_bar &lt;= not qi;&#13;
end rtl;&#13;
</vhdl>
