  <vhdl appearance="logisim_evolution" name="rs_latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity rs_latch is&#13;
    port (&#13;
        s, r : in std_logic;&#13;
        q, q_bar : out std_logic&#13;
    );&#13;
end rs_latch;&#13;
&#13;
architecture gate_level of rs_latch is&#13;
    signal qi, qbi : std_logic;&#13;
begin&#13;
    qi  &lt;= not (r or qbi);&#13;
    qbi &lt;= not (s or qi);&#13;
    q &lt;= qi;&#13;
    q_bar &lt;= qbi;&#13;
end gate_level;&#13;
