  <vhdl appearance="logisim_evolution" name="jk_ff">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity jk_ff is&#13;
    port (&#13;
        j, k, clk : in std_logic;&#13;
        q, q_bar : out std_logic&#13;
    );&#13;
end jk_ff;&#13;
&#13;
architecture rtl of jk_ff is&#13;
    signal qi : std_logic;&#13;
begin&#13;
    process(clk)&#13;
    begin&#13;
        if rising_edge(clk) then&#13;
            if j = '0' and k = '0' then&#13;
                null;&#13;
            elsif j = '0' and k = '1' then&#13;
                qi &lt;= '0';&#13;
            elsif j = '1' and k = '0' then&#13;
                qi &lt;= '1';&#13;
            elsif j = '1' and k = '1' then&#13;
                qi &lt;= not qi;&#13;
            end if;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q &lt;= qi;&#13;
    q_bar &lt;= not qi;&#13;
end rtl;&#13;
</vhdl>
